{
    "compilerOptions": {
        "target": "es2020",
        "allowSyntheticDefaultImports": false,
        "baseUrl": "./",
        "paths": {
            "@mapstore/framework/*": [
                "./MapStore2/web/client/*"
            ],
            "@mapstore/*": [
                "./MapStore2/web/client/*"
            ],
            "@js/*": [
                "./js/*"
            ]
        }
    },
    "include": [
        "MapStore2/web/client/**/*",
        "js/**/*"
    ],
    "exclude": [
        "node_modules",
        "MapStore2/node_modules"
    ]
}
