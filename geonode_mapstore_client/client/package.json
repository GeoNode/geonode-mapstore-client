{
  "name": "geonode-mapstore-client",
  "version": "master",
  "description": "MapStore 2 bundles specific to geonode framework",
  "engines": {
    "node": ">=22"
  },
  "eslintConfig": {
    "extends": [
      "@mapstore/eslint-config-mapstore"
    ],
    "parserOptions": {
      "babelOptions": {
        "configFile": "./MapStore2/build/babel.config.js"
      }
    },
    "globals": {
      "__MAPSTORE_PROJECT_CONFIG__": false
    }
  },
  "scripts": {
    "compile": "npm run clean && webpack build --progress --color --config build-scripts/prod-webpack.config.js",
    "compile:dev": "npm run clean && webpack build --progress --color --config build-scripts/webpack.config.js",
    "build": "npm run compile",
    "start": "webpack serve --progress --color --config build-scripts/webpack.config.js",
    "test": "karma start ./build-scripts/karma.conf.single-run.js --color",
    "test:watch": "karma start ./build-scripts/karma.conf.continuous-test.js --color",
    "lint": "eslint js --ext .jsx,.js --fix",
    "lint:ci": "eslint js --ext .jsx,.js",
    "docs": "jsdoc -r js/plugins js/utils/AppUtils.js ./README.md -d ../../docs -u ../../tutorials -t ./docs-template",
    "clean": "node build-scripts/clean.js",
    "postinstall": "node MapStore2/utility/build/postInstall.js",
    "updateDevDeps": "node build-scripts/updateDevDependencies.js"
  },
  "author": "GeoSolutions",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/preset-env": "7.28.3",
    "@babel/preset-react": "7.27.1",
    "@geosolutions/acorn-jsx": "4.0.2",
    "@geosolutions/jsdoc": "3.4.4",
    "@geosolutions/mocha": "6.2.1-3",
    "@mapstore/eslint-config-mapstore": "1.0.6",
    "@testing-library/react": "12.1.5",
    "axios-mock-adapter": "2.1.0",
    "babel-loader": "10.0.0",
    "babel-plugin-istanbul": "6.0.0",
    "babel-plugin-transform-imports": "2.0.0",
    "copy-webpack-plugin": "5.0.2",
    "css-loader": "5.1.2",
    "css-minimizer-webpack-plugin": "3.0.2",
    "denodeify": "1.2.1",
    "docma": "1.5.1",
    "eslint": "7.32.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-no-only-tests": "2.6.0",
    "eslint-plugin-react": "3.16.1",
    "expect": "1.20.1",
    "file-loader": "2.0.0",
    "html-loader": "2.0.0",
    "html-webpack-plugin": "5.2.0",
    "karma": "6.4.0",
    "karma-chrome-launcher": "3.1.1",
    "karma-cli": "2.0.0",
    "karma-coverage": "2.2.0",
    "karma-coveralls": "2.1.0",
    "karma-firefox-launcher": "2.1.2",
    "karma-junit-reporter": "2.0.1",
    "karma-mocha": "2.0.1",
    "karma-mocha-reporter": "2.2.5",
    "karma-sourcemap-loader": "0.3.8",
    "karma-webpack": "5.0.0",
    "less": "4.1.1",
    "less-loader": "8.0.0",
    "markdownlint-cli": "0.34.0",
    "mini-css-extract-plugin": "1.3.9",
    "mkdirp": "0.5.1",
    "ncp": "2.0.0",
    "postcss": "8.5.10",
    "postcss-loader": "6.1.0",
    "postcss-prefix-selector": "1.10.0",
    "premove": "4.0.0",
    "prettier": "3.5.1",
    "process": "0.11.10",
    "raw-loader": "0.5.1",
    "readline-promise": "1.0.4",
    "redux-devtools": "3.4.0",
    "redux-devtools-dock-monitor": "1.1.2",
    "redux-devtools-log-monitor": "1.3.0",
    "redux-mock-store": "1.2.2",
    "simple-git": "3.36.0",
    "style-loader": "2.0.0",
    "terser": "5.18.1",
    "url-loader": "0.5.7",
    "webpack": "5.104.1",
    "webpack-bundle-size-analyzer": "2.0.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.5",
    "dotenv": "10.0.0",
    "jsdoc": "4.0.0"
  },
  "dependencies": {
    "@jsdoc/salty": "0.2.1",
    "@rjsf/core": "5.19.4",
    "@rjsf/utils": "5.19.4",
    "@rjsf/validator-ajv8": "5.19.4",
    "mapstore": "file:MapStore2",
    "react-helmet": "6.1.0",
    "react-intl": "2.3.0",
    "react-router-dom": "4.1.1",
    "xlsx": "0.18.5"
  }
}
